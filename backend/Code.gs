document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction options(id,values){const el=$(id);for(const v of values){const o=document.createElement('option');o.value=v;o.textContent=v;el.append(o)}}\noptions('addTrade',TRADES);options('trade',TRADES);options('addTown',TOWNS);options('town',TOWNS);\nfunction load(){google.script.run.withSuccessHandler(data=>{profiles=data;const town=$('town');while(town.options.length>1)town.remove(1);options('town',[...new Set([...TOWNS,...data.map(p=>p.town)])].sort());render()}).withFailureHandler(()=>{$('count').textContent='The directory could not be loaded.';$('cards').innerHTML='<div class=\"empty\"><p>Please try again.</p><button onclick=\"load()\">Retry</button></div>'}).getDirectory()}\nfunction score(p){return p.reviews.length?'★ '+(p.reviews.reduce((s,r)=>s+r.rating,0)/p.reviews.length).toFixed(1)+' · '+p.reviews.length+' review'+(p.reviews.length===1?'':'s'):'No reviews yet'}\nfunction render(){const q=$('search').value.toLowerCase();const list=profiles.filter(p=>(!$('trade').value||p.trade===$('trade').value)&&(!$('town').value||p.town===$('town').value)&&[p.name,p.trade,p.description,p.languages,p.area,p.town].join(' ').toLowerCase().includes(q));$('count').textContent=list.length+' tradespeople';$('cards').innerHTML=list.length?list.map(p=>'<article class=\"card\"><span class=\"tag\">'+esc(p.trade)+'</span><h3>'+esc(p.name)+'</h3><p class=\"muted\">'+esc(p.town)+'</p><p class=\"rating\">'+esc(score(p))+'</p><p class=\"description\">'+esc(p.description.slice(0,170))+'</p><button data-id=\"'+esc(p.id)+'\">View profile & reviews</button></article>').join(''):'<div class=\"empty\"><h3>'+(profiles.length?'No matching tradespeople':'Be the first to share a local contact')+'</h3><p class=\"muted\">'+(profiles.length?'Try another town, trade or search.':'The directory is new. Suggest a tradesperson to get it started.')+'</p><button onclick=\"openAdd()\">Add a tradesperson</button></div>';document.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>openProfile(b.dataset.id))}\nfunction openAdd(){$('add').showModal()}\nfunction openProfile(id){const p=profiles.find(p=>p.id===id);if(!p)return;const phone=p.phone.replace(/[^+\\d]/g,'');const wa=p.phone.replace(/\\D/g,'');$('profileBody').innerHTML='<span class=\"tag\">'+esc(p.trade)+'</span><h2>'+esc(p.name)+'</h2><p>'+esc(p.town)+'</p><p>'+esc(p.description)+'</p><p class=\"muted\">Areas served: '+esc(p.area||p.town)+'<br>Languages: '+esc(p.languages||'Not specified')+'</p>'+(wa.length>=7?'<p><a class=\"button\" href=\"tel:'+esc(phone)+'\">Call</a> <a class=\"button\" href=\"https://wa.me/'+wa+'\" target=\"_blank\" rel=\"noopener\">WhatsApp</a></p>':'')+'<h3>'+esc(score(p))+'</h3>'+p.reviews.map(r=>'<div class=\"review\"><strong>'+esc(r.author)+' · '+r.rating+'/5</strong><br><small class=\"muted\">Work: '+esc(r.month)+'</small><br>'+esc(r.comment)+'</div>').join('');$('reviewForm').reset();$('reviewForm').elements.id.value=id;$('reviewForm').querySelector('.error').textContent='';$('profile').showModal()}\nfunction send(event,type){event.preventDefault();const f=event.target;const b=f.querySelector('[type=submit]');b.disabled=true;f.querySelector('.error').textContent='';const payload=Object.fromEntries(new FormData(f));payload.type=type;google.script.run.withSuccessHandler(()=>{b.disabled=false;f.reset();f.closest('dialog').close();$('toast').hidden=false;$('toast').textContent='Thank you! Your submission is waiting for approval.';setTimeout(()=>$('toast').hidden=true,6000)}).withFailureHandler(e=>{b.disabled=false;f.querySelector('.error').textContent=e.message||'Please try again.'}).submitEntry(payload)}\nload();\n</script></body></html>\n";
