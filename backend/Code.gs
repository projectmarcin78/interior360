orrei','cerco','from','can','you','please','would','like']);const words=q.split(' ').filter(w=>w.length>2&&!stop.has(w));if(!words.length)return [];return SERVICES.map(s=>{const name=normal(s.name),hay=normal(s.name+' '+s.keywords);const tokens=hay.split(' ');let score=words.reduce((n,w)=>n+(tokens.some(t=>t===w||(w.length>4&&t.startsWith(w.slice(0,-1))))?1:0),0);if(q.includes(name))score+=3;return {id:s.id,score};}).filter(s=>s.score>0).sort((a,b)=>b.score-a.score).slice(0,6).map(s=>s.id)}\nfunction options(id,values){const el=$(id);for(const v of values){const o=document.createElement('option');o.value=v;o.textContent=v;el.append(o)}}\nfunction fillServices(){const el=$('trade');el.replaceChildren(new Option('All services',''));for(const g of SERVICE_GROUPS){if($('category').value&&$('category').value!==g.name)continue;const opt=document.createElement('optgroup');opt.label=g.name;for(const s of g.services)opt.append(new Option(s.name,s.id));el.append(opt)}}\nfunction changeCategory(){clearSuggested();fillServices();render()}\nfunction clearSuggested(){suggestedServices=[];}\nfunction renderServiceChoices(){$('serviceChoices').innerHTML=SERVICE_GROUPS.map(g=>'<details><summary>'+esc(g.name)+'</summary>'+g.services.map(s=>'<label class=\"service-choice\" data-service=\"'+s.id+'\"><input type=\"checkbox\" name=\"services\" value=\"'+s.id+'\" onchange=\"updateServiceCount()\">'+esc(s.name)+'</label>').join('')+'</details>').join('')}\nfunction updateServiceCount(){const fields=[...$('addForm').querySelectorAll('[name=services]')];const count=fields.filter(x=>x.checked).length;$('serviceCount').textContent=count+' / 15 services selected';fields.forEach(f=>f.disabled=count>=15&&!f.checked);const rental=fields.some(f=>f.checked&&f.value==='car-rental-local-contacts');$('localRentalLabel').hidden=!rental;$('addForm').elements.localRental.required=rental;if(!rental)$('addForm').elements.localRental.checked=false}\nfunction filterServiceChoices(){const q=normal($('serviceSearch').value);for(const d of $('serviceChoices').children){let visible=0;for(const label of d.querySelectorAll('.service-choice')){const s=serviceById[label.dataset.service];label.hidden=!!q&&!normal(s.name+' '+s.keywords).includes(q);if(!label.hidden)visible++}d.hidden=!visible;d.open=!!q&&!!visible}}\nlet accessToken='',accessExpires=0,accessGeneration=0,accessTimer;\nfunction accessStored(value){try{if(value)localStorage.setItem('sicilycrew.session',JSON.stringify(value));else localStorage.removeItem('sicilycrew.session')}catch(e){}}\nfunction accessClear(message=''){\n accessGeneration++;accessToken='';accessExpires=0;clearTimeout(accessTimer);accessStored(null);profiles=[];\n $('cards').replaceChildren();$('profileBody').replaceChildren();$('count').textContent='Sign in to view contacts.';\n document.querySelectorAll('dialog[open]').forEach(d=>d.close());$('addForm').reset();$('reviewForm').reset();\n document.body.classList.add('locked');$('accessPanel').hidden=false;$('signOutButton').hidden=true;\n $('accessMessage').textContent=message;$('accessCode').value='';\n}\nfunction accessFailure(error){return String(error?.message||error||'').includes('SIGN_IN_REQUIRED')}\nfunction accessOpen(session,token){\n accessToken=token;accessExpires=session.expires;accessStored({token,expires:session.expires});\n document.body.classList.remove('locked');$('accessPanel').hidden=true;$('signOutButton').hidden=false;\n $('memberPhone').textContent=session.phone;$('accessCode').value='';\n scheduleAccessExpiry();\n load();\n}\nfunction scheduleAccessExpiry(){\n clearTimeout(accessTimer);const remaining=accessExpires-Date.now();\n if(remaining<=0){accessClear('Your sign-in has expired. Ask the PM on WhatsApp for a new access code to sign in for another 90 days.');return}\n // Recheck daily: a 90-day setTimeout exceeds the browser's timer limit.\n accessTimer=setTimeout(scheduleAccessExpiry,Math.min(remaining,86400000));\n}\nfunction verifyCode(event){\n event.preventDefault();i