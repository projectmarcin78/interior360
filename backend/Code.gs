 const comment=text_(p.comment,1500,true);if(comment.length<10)throw new Error('Please describe your experience in at least 10 characters.');
 tab='Reviews';row=[Utilities.getUuid(),id,text_(p.author,60,true),rating,comment,month,'Pending',new Date().toISOString()];
 }
 SpreadsheetApp.openById(SHEET_ID).getSheetByName(tab).appendRow(row.map(safe_));cache.put(digest,'1',600);return {ok:true};
