const SHEET_ID = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
function doGet(){return HtmlService.createHtmlOutput(PAGE_HTML).setTitle('Sicily Tradespeople · Interior360').addMetaTag('viewport','width=device-width, initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function rows_(name){const s=SpreadsheetApp.openById(SHEET_ID).getSheetByName(name);if(!s)throw new Error('Database tab missing.');return s.getDataRange().getDisplayValues().slice(1);}
function getDirectory(){
 const reviews=rows_('Reviews').filter(r=>r[6]==='Approved'&&Number.isInteger(Number(r[3]))&&Number(r[3])>=1&&Number(r[3])<=5);
 return rows_('Tradespeople').filter(r=>r[8]==='Approved'&&r[0]&&r[1]).map(r=>({id:r[0],name:r[1],trade:r[2],town:r[3],area:r[4],languages:r[5],phone:r[6],description:r[7],reviews:reviews.filter(v=>v[1]===r[0]).map(v=>({author:v[2],rating:Number(v[3]),comment:v[4],month:v[5]}))}));
}
function text_(v,max,required){const t=String(v||'').trim();if((required&&!t)||t.length>max)throw new Error('Please complete all required fields within the length limits.');return t;}
function safe_(v){return /^[=+\-@]/.test(String(v))?"'"+v:v;}
function submitEntry(p){
 if(!p||!['profile','review'].includes(p.type)||p.website||p.consent!=='on')throw new Error('Please check the form and confirm the declaration.');
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{
 const cache=CacheService.getScriptCache();const digest=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(p)));
 if(cache.get(digest))throw new Error('This submission has already been received.');
 let tab,row;
 if(p.type==='profile'){
 const name=text_(p.name,100,true),trade=text_(p.trade,60,true),town=text_(p.town,80,true);
 if(!TOWNS.includes(town))throw new Error('Choose a town from the list.');
if(!['Builder / renovation team','Electrician','Plumber','Painter','Tiler','Carpenter','Roofer','Windows & doors','Gardener','Other'].includes(trade))throw new Error('Choose a valid trade.');
 const phone=text_(p.phone,30,false);if(phone&&!/^\+?[\d\s().-]{7,30}$/.test(phone))throw new Error('Please enter a valid business phone number.');
 if(rows_('Tradespeople').some(r=>r[1].toLowerCase()===name.toLowerCase()&&r[3].toLowerCase()===town.toLowerCase()&&r[8]!=='Rejected'))throw new Error('This name and town are already listed or awaiting approval.');
 tab='Tradespeople';row=[Utilities.getUuid(),name,trade,town,text_(p.area,200,false),text_(p.languages,100,false),phone,text_(p.description,1000,true),'Pending',new Date().toISOString()];
 }else{
 const id=text_(p.id,100,true);if(!rows_('Tradespeople').some(r=>r[0]===id&&r[8]==='Approved'))throw new Error('This tradesperson is no longer available.');
 const rating=Number(p.rating);if(!Number.isInteger(rating)||rating<1||rating>5)throw new Error('Choose a rating from 1 to 5.');
