const SHEET_ID = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
/** Run once from the Apps Script project attached to the SicilyCrew database. */
function setupSicilyCrew(){
 authOwner_();
 const sheet=SpreadsheetApp.getActiveSpreadsheet();
 if(!sheet)throw new Error('Open Apps Script from the database spreadsheet using Extensions > Apps Script.');
 const expected={Tradespeople:['ID','Name','Trade','Town','Service area','Languages','Phone','Description','Status','Submitted at'],Reviews:['ID','Tradesperson ID','Display name','Rating','Comment','Work month','Status','Submitted at']};
 for(const name of Object.keys(expected)){
  const tab=sheet.getSheetByName(name);if(!tab)throw new Error('Missing database tab: '+name);
  const actual=tab.getRange(1,1,1,expected[name].length).getDisplayValues()[0];
  if(actual.some((v,i)=>v!==expected[name][i]))throw new Error('Unexpected headers in '+name+'. Existing data was not changed.');
 }
 let members=sheet.getSheetByName('Members');
 if(!members){
  members=sheet.insertSheet('Members');members.getRange(1,1,1,3).setValues([['Phone','Name','Status']]);
  members.getRange(2,1,members.getMaxRows()-1,1).setNumberFormat('@');
  members.getRange(2,1,1,3).setValues([['+48603760320','Marcin','Active']]);members.setFrozenRows(1);
  members.getRange(1,1,1,3).setBackground('#f3f3f3').setFontWeight('bold');
  members.setColumnWidth(1,290);members.setColumnWidth(2,190);members.setColumnWidth(3,120);
 }
 const mh=members.getRange(1,1,1,3).getDisplayValues()[0];
 if(['Phone','Name','Status'].some((h,i)=>mh[i]!==h))throw Error('Unexpected Members headers. Existing data was not changed.');
 const rule=SpreadsheetApp.newDataValidation().requireValueInList(['Active','Blocked'],true).setAllowInvalid(false).build();
 members.getRange(2,3,members.getMaxRows()-1,1).setDataValidation(rule);
 const props=PropertiesService.getScriptProperties();props.setProperty('SPREADSHEET_ID',sheet.getId());
 if(!props.getProperty('SC_AUTH_SECRET'))props.setProperty('SC_AUTH_SECRET',authRandom_());

 console.log('SicilyCrew private access configured. Add phone numbers in Members, then use the SicilyCrew menu to generate codes.');
 return {ok:true};
}
// Private group access. Codes are generated only by the owner, then sent manually.
const AUTH_SESSION_SECONDS=7776000; // 90 days; access is rechecked on every data request.
const AUTH_CODE_SECONDS=1800; // 30 minutes, one use, at most five attempts.
function authOwner_(){
 const active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail();
 if(!active||active!==effective)throw Error('Open the private database as its owner to manage access.');
}
function authPhone_(value){
 let phone=String(value||'').trim().replace(/[\s().-]/g,'');if(phone.startsWith('00'))phone='+'+phone.slice(2);
 return /^\+[1-9]\d{7,14}$/.test(phone)?phone:'';
}
function authHash_(value){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value)).replace(/=+$/,'');}
function authRandom_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function authSecret_(){const s=PropertiesService.getScriptProperties().getProperty('SC_AUTH_SECRET');if(!s)throw Error('Sign-in is not available yet. Please contact the PM.');return s;}
function authMac_(value){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(value,authSecret_())).replace(/=+$/,'');}
function authAllowed_(phone){
 if(!phone)return false;
 const tab=SpreadsheetApp.openById(SHEET_ID).getSheetByName('Members');if(!tab)return false;
 const rows=tab.getDataRange().getDisplayValues();
 if(['Phone','Name','Status'].some((h,i)=>rows[0]?.[i]!==h))return false;
 const matches=rows.slice(1).filter(r=>authPhone_(r[0])===phone);
 return matches.length===1&&matches[0][2]==='Active';
}
function authRecord_(key){const value=PropertiesService.getScriptProperties().getProperty(key);try{return value?JSON.parse(value):null}catch(e){return null}}
function authSave_(key,value){PropertiesService.getScriptProperties().setProperty(key,JSON.stringify(value));}
function authCleanup_(){
 const props=PropertiesService.getScriptProperties(),now=Date.now();
 for(const [key,value] of Object.entries(props.getProperties())){
  if(!key.startsWith('SC_TMP_'))continue;
  try{if(JSON.parse(value).expires<=now)props.deleteProperty(key)}catch(e){props.deleteProperty(key)}
 }
}
function onOpen(){SpreadsheetApp.getUi().createMenu('SicilyCrew').addItem('Generate WhatsApp access code','generateWhatsAppCode').addToUi();}
/** Owner-only: select a Members row first. No code is written into spreadsheet cells or logs. */
function generateWhatsAppCode(){
 authOwner_();const sheet=SpreadsheetApp.getActiveSpreadsheet(),range=sheet?.getActiveRange();
 if(!sheet||sheet.getId()!==SHEET_ID||!range||range.getSheet().getName()!=='Members'||range.getRow()<2||range.getNumRows()!==1)throw Error('Select one person’s row in Members first.');
 const row=range.getSheet().getRange(range.getRow(),1,1,3).getDisplayValues()[0];
 const phone=authPhone_(row[0]);if(!authAllowed_(phone))throw Error('Use one unique phone number with its country code, and set Status to Active.');
 const lock=LockService.getScriptLock();lock.waitLock(10000);let code;
 try{
  authSecret_();authCleanup_();
  code=(parseInt(Utilities.getUuid().replace(/-/g,'').slice(0,12),16)%100000000).toString().padStart(8,'0');
  authSave_('SC_TMP_CODE_'+authHash_(phone),{mac:authMac_(phone+'|'+code),attempts:0,expires:Date.now()+AUTH_CODE_SECONDS*1000});
 }finally{lock.releaseLock()}
 const message='Your SicilyCrew access code: '+code+'\n\nOpen https://projectmarcin78.github.io/interior360/sicily-tradespeople/ and enter your phone number with country code and this code.\n\nThe code expires in 30 minutes and works once. Please keep it private.';
 const url='https://wa.me/'+phone.slice(1)+'?text='+encodeURIComponent(message);
 const html='<div style="font:15px/1.6 system-ui;padding:18px"><h2>SicilyCrew access code</h2><p>For '+phone+'</p><p style="font-size:32px;letter-spacing:4px;font-weight:700">'+code+'</p><p>Valid for 30 minutes, one use. A new code replaces the previous code.</p><p><a target="_blank" rel="noopener noreferrer" href="'+url+'">Open WhatsApp with this message</a></p><p>You must press Send in WhatsApp yourself. Nothing has been sent automatically.</p><p>Alternatively, copy the code and send it in a private message to this person.</p></div>';
 SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(html).setWidth(470).setHeight(390),'SicilyCrew');
 return {ok:true};
}
function verifyAccessCode(value,code){
 const denied=()=>{throw Error('The phone number or code is incorrect, expired or no longer allowed. Ask the PM for a new code.')};
 const phone=authPhone_(value);if(!phone)return denied();
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{
  const key='SC_TMP_CODE_'+authHash_(phone),record=authRecord_(key),props=PropertiesService.getScriptProperties();
  if(!record||record.expires<=Date.now()||record.attempts>=5){props.deleteProperty(key);return denied()}
  record.attempts++;authSave_(key,record);
  if(!/^\d{8}$/.test(String(code||''))||authMac_(phone+'|'+code)!==record.mac){if(record.attempts>=5)props.deleteProperty(key);return denied()}
  props.deleteProperty(key);if(!authAllowed_(phone))return denied();
  const token=authRandom_(),expires=Date.now()+AUTH_SESSION_SECONDS*1000;
  authSave_('SC_TMP_SESSION_'+authHash_(token),{phone,expires});
  return {token,phone,expires};
 }finally{lock.releaseLock()}
}
function authRequire_(token){
 if(!/^[a-f0-9]{64}$/.test(String(token||'')))throw Error('SIGN_IN_REQUIRED');
 const key='SC_TMP_SESSION_'+authHash_(token),session=authRecord_(key);
 if(!session||session.expires<=Date.now()||!authAllowed_(session.phone)){PropertiesService.getScriptProperties().deleteProperty(key);throw Error('SIGN_IN_REQUIRED')}
 return session;
}
function getAccessSession(token){const s=authRequire_(token);return {phone:s.phone,expires:s.expires};}
function signOut(token){if(/^[a-f0-9]{64}$/.test(String(token||'')))PropertiesService.getScriptProperties().deleteProperty('SC_TMP_SESSION_'+authHash_(token));return {ok:true};}

function doGet(){return HtmlService.createHtmlOutput(PAGE_HTML).setTitle('SicilyCrew — Find local tradespeople in Sicily').addMetaTag('viewport','width=device-width, initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function rows_(name){const s=SpreadsheetApp.openById(SHEET_ID).getSheetByName(name);if(!s)throw new Error('Database tab missing.');return s.getDataRange().getDisplayValues().slice(1);}
function getDirectory(token){
 authRequire_(token);
 const reviews=rows_('Reviews').filter(r=>r[6]==='Approved'&&Number.isInteger(Number(r[3]))&&Number(r[3])>=1&&Number(r[3])<=5);
 return rows_('Tradespeople').filter(r=>r[8]==='Approved'&&r[0]&&r[1]).map(r=>({id:r[0],name:r[1],trade:r[2],services:servicesFromCell_(r[2]),town:r[3],area:r[4],languages:r[5],phone:r[6],description:r[7],reviews:reviews.filter(v=>v[1]===r[0]).map(v=>({author:v[2],rating:Number(v[3]),comment:v[4],month:v[5]}))}));
}
function text_(v,max,required){const t=String(v||'').trim();if((required&&!t)||t.length>max)throw new Error('Please complete all required fields within the length limits.');return t;}
function safe_(v){return /^[=+\-@]/.test(String(v))?"'"+v:v;}
function submitEntry(p,token){
 authRequire_(token);
 if(!p||!['profile','review'].includes(p.type)||p.website||p.consent!=='on')throw new Error('Please check the form and confirm the declaration.');
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{
 const cache=CacheService.getScriptCache();const digest=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(p)));
 if(cache.get(digest))throw new Error('This submission has already been received.');
 let tab,row;
 if(p.type==='profile'){
 const name=text_(p.name,100,true),town=text_(p.town,80,true);
 const services=Array.isArray(p.services)?[...new Set(p.services)]:[];
 if(!services.length||services.length>15||services.some(id=>!SERVICE_IDS.includes(id)))throw new Error('Choose between 1 and 15 valid services.');
 if(services.includes('car-rental-local-contacts')&&p.localRental!=='on')throw new Error('Confirm that this is a local independent car rental contact.');
 const trade=JSON.stringify(services);
 if(!TOWNS.includes(town))throw new Error('Choose a town from the list.');

 const phone=text_(p.phone,30,false);if(phone&&!/^\+?[\d\s().-]{7,30}$/.test(phone))throw new Error('Please enter a valid business phone number.');
 if(rows_('Tradespeople').some(r=>r[1].toLowerCase()===name.toLowerCase()&&r[3].toLowerCase()===town.toLowerCase()&&r[8]!=='Rejected'))throw new Error('This name and town are already listed or awaiting approval.');
 tab='Tradespeople';row=[Utilities.getUuid(),name,trade,town,text_(p.area,200,false),text_(p.languages,100,false),phone,text_(p.description,1000,true),'Pending',new Date().toISOString()];
 }else{
 const id=text_(p.id,100,true);if(!rows_('Tradespeople').some(r=>r[0]===id&&r[8]==='Approved'))throw new Error('This contact is no longer available.');
 const rating=Number(p.rating);if(!Number.isInteger(rating)||rating<1||rating>5)throw new Error('Choose a rating from 1 to 5.');
 const month=text_(p.month,7,true);if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)||month>new Date().toISOString().slice(0,7))throw new Error('Choose a valid past or current month.');
 const comment=text_(p.comment,1500,true);if(comment.length<10)throw new Error('Please describe your experience in at least 10 characters.');
 tab='Reviews';row=[Utilities.getUuid(),id,text_(p.author,60,true),rating,comment,month,'Pending',new Date().toISOString()];
 }
 SpreadsheetApp.openById(SHEET_ID).getSheetByName(tab).appendRow(row.map(safe_));cache.put(digest,'1',600);return {ok:true};
 }finally{lock.releaseLock();}
}


function servicesFromCell_(value){
 try{const parsed=JSON.parse(value);if(Array.isArray(parsed))return parsed.filter(id=>SERVICE_IDS.includes(id));}catch(e){}
