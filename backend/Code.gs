en);\n }\n setInterval(checkAccess,60000);document.addEventListener('visibilitychange',checkAccess);\n}\nfunction load(){\n if(!accessToken){accessClear();return}\n const token=accessToken,generation=accessGeneration;\n google.script.run.withSuccessHandler(data=>{if(generation!==accessGeneration||token!==accessToken)return;profiles=Array.isArray(data)?data:[];render()})\n .withFailureHandler(e=>{if(generation!==accessGeneration||token!==accessToken)return;if(accessFailure(e)){accessClear('Your sign-in has expired or access was removed. Ask the PM on WhatsApp for a new access code.');return}$('count').textContent='Contacts could not be loaded.';$('cards').innerHTML='<div class=\"empty\"><p>Please try again.</p><button onclick=\"load()\">Retry</button></div>'}).getDirectory(token);\n}\nfunction score(p){const reviews=p.reviews||[];return reviews.length?'★ '+(reviews.reduce((s,r)=>s+Number(r.rating),0)/reviews.length).toFixed(1)+' / 5 · '+reviews.length+' review'+(reviews.length===1?'':'s'):'No reviews yet'}\nfunction visibleProfiles(){const q=normal($('search').value),category=$('category').value,service=$('trade').value,town=$('town').value;return profiles.filter(p=>{const ids=servicesOf(p);const categoryMatch=!category||ids.some(id=>serviceById[id]?.category===category);const serviceMatch=!service||ids.includes(service);const suggestedMatch=!suggestedServices.length||ids.some(id=>suggestedServices.includes(id));const hay=normal([p.name,p.trade,serviceNames(p),p.description,p.languages,p.area,p.town,...ids.map(id=>serviceById[id]?.keywords||'')].join(' '));const textMatch=!q||hay.includes(q)||q.split(' ').every(w=>hay.includes(w));return categoryMatch&&serviceMatch&&suggestedMatch&&(!town||p.town===town)&&textMatch}).sort((a,b)=>{const reviews=p=>p.reviews||[],avg=p=>reviews(p).length?reviews(p).reduce((s,r)=>s+Number(r.rating),0)/reviews(p).length:0;return ($('sort').value==='rating'?(avg(b)-avg(a)):($('sort').value==='reviews'?(reviews(b).length-reviews(a).length):0))||String(a.name).localeCompare(String(b.name))})}\nfunction render(){const list=visibleProfiles();$('count').textContent=list.length+' contact'+(list.length===1?'':'s');$('cards').innerHTML=list.length?list.map(p=>'<article class=\"card\"><span class=\"tag\">'+esc(serviceNames(p))+'</span><h3>'+esc(p.name)+'</h3><p class=\"muted\">'+esc(p.town)+'</p><p class=\"rating\">'+esc(score(p))+'</p><p>'+esc(String(p.description||'').slice(0,170))+'</p><div class=\"card-actions\"><button data-profile=\"'+esc(p.id)+'\">View contact</button><button class=\"review-button\" data-review=\"'+esc(p.id)+'\">☆ Leave a review</button></div></article>').join(''):'<div class=\"empty\"><h3>'+(profiles.length?'No matching contacts':'No contacts yet')+'</h3><p class=\"muted\">'+(profiles.length?'Try another service, town or search.':'Browse services or suggest someone using Add a contact in the header.')+'</p></div>';document.querySelectorAll('[data-profile]').forEach(b=>b.onclick=()=>openProfile(b.dataset.profile));document.querySelectorAll('[data-review]').forEach(b=>b.onclick=()=>openProfile(b.dataset.review,true))}\nfunction resetFilters(){$('search').value='';$('category').value='';$('town').value='';$('sort').value='name';fillServices();clearSuggested();render()}\nfunction openAdd(){if(!accessToken)return;$('add').showModal()}\nfunction reviewBreakdown(p){const rs=p.reviews||[];return rs.length?'<p class=\"notice\">'+rs.filter(r=>Number(r.rating)>=4).length+' positive (4–5★) · '+rs.filter(r=>Number(r.rating)===3).length+' neutral (3★) · '+rs.filter(r=>Number(r.rating)<=2).length+' negative (1–2★)</p>':''}\nfunction openProfile(id,review=false){if(!accessToken)return;const p=profiles.find(p=>p.id===id);if(!p)return;const phone=String(p.phone||'').replace(/[^+\\d]/g,''),wa=phone.replace(/\\D/g,'');$('profileBody').innerHTML='<span class=\"tag\">'+esc(serviceNames(p))+'</span><h2>'+esc(p.name)+'</h2><p>'+esc(p.town)+'</p><p>'+esc(p.description)+'</p><p class=\"muted\">Areas served: '+esc(p.area||p.town)+'<br>Languages: '+esc(p.languages||'Not specified')+'</p>'+(wa.length>=7?'<p><a class=\"button\" href=\"tel:'+esc(phone)+'\">Call</a> <a class=\"button\" href=\"https://wa.me/'+wa+'\" target=\"_blank\" rel=\"noopener\">WhatsApp</a></p>':'')+'<h3>'+esc(score(p))+'</h3>'+reviewBreakdown(p)+(p.reviews||[]).map(r=>'<div class=\"review\"><strong>'+esc(r.author)+'</strong> · <span class=\"stars-display\" role=\"img\" aria-label=\"'+Number(r.rating)+' out of 5 stars\">'+'★'.repeat(Number(r.rating))+'☆'.repeat(5-Number(r.rating))+'</span><br><small class=\"muted\">Service: '+esc(r.month)+'</small><p>'+esc(r.comment)+'</p></div>').join('');$('reviewForm').reset();$('reviewForm').elements.id.value=id;$('reviewForm').querySelector('.error').textContent='';$('profile').showModal();if(review){$('reviewHeading').focus();$('reviewHeading').scrollIntoView({block:'start'})}}\nfunction send(event,type){event.preventDefault();const f=event.target;if(!accessToken){accessClear('Please sign in first.');return}const requestToken=accessToken,generation=accessGeneration;const payload=Object.fromEntries(new FormData(f));if(type==='profile'){payload.services=new FormData(f).getAll('services');if(!payload.services.length){f.querySelector('.error').textContent='Select at least one service.';$('serviceChoices').scrollIntoView({block:'center'});return;}}const b=f.querySelector('[type=submit]');b.disabled=true;f.querySelector('.error').textContent='';payload.type=type;google.script.run.withSuccessHandler(()=>{b.disabled=false;if(generation!==accessGeneration||requestToken!==accessToken)return;f.reset();if(type==='profile'){updateServiceCount();filterServiceChoices()}f.closest('dialog').close();$('toast').hidden=false;$('toast').textContent='Thank you! Your submission is waiting for approval.';setTimeout(()=>$('toast').hidden=true,6000)}).withFailureHandler(e=>{b.disabled=false;if(generation!==accessGeneration||requestToken!==accessToken)return;if(accessFailure(e)){accessClear('Your sign-in has expired or access was removed. Ask the PM on WhatsApp for a new access code.');return}f.querySelector('.error').textContent=e.message||'Please try again.'}).submitEntry(payload,requestToken)}\n\noptions('category',SERVICE_GROUPS.map(g=>g.name));fillServices();options('addTown',TOWNS);options('town',TOWNS);renderServiceChoices();\ninitAuth();\n</script></body></html>";
